<Window x:Class="ChGhost.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SystemHelper"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        WindowState="Maximized">
    <Canvas x:Name="OverlayCanvas">
        <Border x:Name="StatusBox" Canvas.Left="20" Canvas.Top="20"
                Background="#DD11161D" BorderBrush="#00FF88" BorderThickness="1.5"
                CornerRadius="8" Padding="14,10">
            <StackPanel>
                <TextBlock x:Name="HeaderText" Foreground="#00FF88"
                           FontFamily="Consolas" FontSize="14" FontWeight="Bold"
                           Text="CHESS GHOST [AI] • БЕЛЫЕ • ПАУЗА"/>
                <TextBlock x:Name="StatusText" Foreground="#FFFFFF"
                           FontFamily="Consolas" FontSize="13" Margin="0,4,0,6"
                           Text="1. Угол A8 -> Alt+1 | 2. Угол H1 -> Alt+2"/>
                <Border Height="1" Background="#33FFFFFF" Margin="0,2,0,6"/>
                <TextBlock x:Name="HotkeysText" Foreground="#99AAB5"
                           FontFamily="Consolas" FontSize="11"
                           Text="Alt+1/2: углы | Alt+3: фигура | Alt+4: отмена | Alt+5: сброс&#x0a;Alt+S: старт/пауза | Alt+C: цвет | Alt+H: скрыть | Alt+Q: выход"/>
            </StackPanel>
        </Border>
    </Canvas>
</Window>